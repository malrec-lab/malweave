# Build once, review/save its resulting image ID, and reuse it on every worker.
FROM ghcr.io/astral-sh/uv:0.11.9@sha256:6b6fa841d71a48fbc9e2c55651c5ad570e01104d7a7d701f57b2b22c0f58e9b1 AS uv
FROM ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac
ENV DEBIAN_FRONTEND=noninteractive UV_PYTHON_INSTALL_DIR=/opt/python UV_LINK_MODE=copy
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl file dpkg unzip libglib2.0-0 libpcre2-16-0 \
      libdouble-conversion3 libatomic1 libstdc++6 zlib1g && \
    rm -rf /var/lib/apt/lists/*
COPY --from=uv /uv /usr/local/bin/uv
RUN uv python install 3.12.12
WORKDIR /opt/malweave
COPY pyproject.toml uv.lock .python-version README.md ./
COPY malweave ./malweave
COPY configs ./configs
COPY tests ./tests
COPY Dockerfile.sorel ./
RUN uv sync --locked --no-default-groups && \
    uv run --locked --no-default-groups malweave data sorel-setup --skip-metadata
RUN curl -fsSL --connect-timeout 20 --max-time 240 \
      https://awscli.amazonaws.com/awscli-exe-linux-x86_64-2.34.45.zip -o /tmp/aws.zip && \
    echo '2b382fd5c1e8d73f6aaca18e5850758fb9f70a20af9c17deb3078df0dd4af095  /tmp/aws.zip' | sha256sum -c - && \
    unzip -q /tmp/aws.zip -d /tmp && /tmp/aws/install && rm -rf /tmp/aws /tmp/aws.zip
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
STOPSIGNAL SIGINT
ENTRYPOINT ["/opt/malweave/.venv/bin/python", "-m", "malweave"]
