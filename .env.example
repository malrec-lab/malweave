# Default single-worker layout inside this checkout. Copy to .env; only change
# entries when the corpus or fast local disk lives elsewhere. The raw root
# contains dataset/, Benign.csv, and Ransomware.csv in this combined layout.
export GHIDRA_ROOT=${HOME}/ghidra/ghidra_11.2.1_PUBLIC
export MALWEAVE_RANDS_DIR=data/raw/rands
export MALWEAVE_RANDS_METADATA_DIR=data/raw/rands
export MALWEAVE_OUTPUT_DIR=data/processed/rands
export MALWEAVE_STATE_DIR=data/processed/rands/ghidra-state
export MALWEAVE_WORK_DIR=data/interim/rands/ghidra-work
export MALWEAVE_SHARD_PLAN_DIR=data/interim/rands/ghidra-plan
export MALWEAVE_WORKERS=1
export MALWEAVE_CONFIG=configs/datasets/rands-raw-2026.yaml

# S3 inventory/staging: set the private bucket name on the worker.
# Use the AWS credential provider chain (temporary, read-only credentials preferred).
# Do not commit credentials or reuse credentials exposed in chat/logs.
# MALWEAVE_RANDS_S3_BUCKET=your-private-bucket
# AWS_DEFAULT_REGION=ap-southeast-1
