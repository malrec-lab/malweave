# Raw RanDS / optional Ghidra worker template. Copy only if .env is absent.
# RanDS has been converted to EXE and uploaded to S3.
# For local RanDS archives, the input root contains dataset/, Benign.csv, Ransomware.csv.
# Actual S3 locations/credentials stay private.
# Shared dataset S3 settings. Use the dataset bucket owner's account ID.
# AWS_PROFILE=malweave-worker
# AWS_DEFAULT_REGION=ap-southeast-1
# MALWEAVE_S3_ACCOUNT_ID=YOUR-ACCOUNT-ID
# Credentials are configured separately with: aws configure --profile malweave-worker
export GHIDRA_ROOT=${HOME}/ghidra/ghidra_11.2.1_PUBLIC
export MALWEAVE_RANDS_DIR=data/raw/rands
export MALWEAVE_RANDS_METADATA_DIR=data/raw/rands
export MALWEAVE_OUTPUT_DIR=data/processed/rands
export MALWEAVE_STATE_DIR=data/processed/rands/ghidra-state
export MALWEAVE_WORK_DIR=data/interim/rands/ghidra-work
export MALWEAVE_SHARD_PLAN_DIR=data/interim/rands/ghidra-plan
export MALWEAVE_WORKERS=1
export MALWEAVE_CONFIG=configs/datasets/rands-raw-2026.yaml

# RanDS from its published S3 bucket. Replace YOUR-RANDS-BUCKET.
# MALWEAVE_RANDS_RAW_S3_PREFIX=s3://YOUR-RANDS-BUCKET/representations/raw
# MALWEAVE_RANDS_EXE_S3_PREFIX=s3://YOUR-RANDS-BUCKET/representations/exe
# MALWEAVE_RANDS_TRAIN_S3_PREFIX=s3://YOUR-RANDS-BUCKET/experiments
# MALWEAVE_RANDS_METADATA_S3_PREFIX=s3://YOUR-RANDS-BUCKET/metadata
