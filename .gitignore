# Local configuration may contain credentials or machine-specific paths.
.env
.env.*
!.env.example

# Dataset contents are intentionally local. Keep only directory guidance in Git.
# Matches both the shared top-level lifecycle dirs and any per-dataset ones
# nested under data/<dataset_name>/{raw,external,interim,processed}/.
/data/external/*
/data/*/external/*
!/data/external/.gitkeep
!/data/*/external/.gitkeep
/data/interim/*
/data/*/interim/*
!/data/interim/.gitkeep
!/data/*/interim/.gitkeep
/data/processed/*
/data/*/processed/*
!/data/processed/.gitkeep
!/data/*/processed/.gitkeep
/data/raw/*
/data/*/raw/*
!/data/raw/.gitkeep
!/data/*/raw/.gitkeep

# Training artifacts are reproducible outputs, not source files.
/models/*
!/models/.gitkeep
!/models/README.md
/reports/*
!/reports/README.md
!/reports/figures/
/reports/figures/*
!/reports/figures/.gitkeep
/runs/
/wandb/
/mlruns/
/lightning_logs/

# Python and test tooling.
__pycache__/
*.py[cod]
*.so
.coverage
.coverage.*
.hypothesis/
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/

# Virtual environments and build products.
.venv/
venv/
build/
dist/
*.egg-info/

# Notebook and editor state.
.ipynb_checkpoints/
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# Built documentation.
docs/mkdocs/site/
