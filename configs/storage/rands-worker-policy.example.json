{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListRandsInputsAndTrainingResults",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket"],
      "Resource": "arn:aws:s3:::YOUR-RANDS-BUCKET"
    },
    {
      "Sid": "ReadExtractedRandsAndLabelsOnly",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::YOUR-RANDS-BUCKET/dataset.json",
        "arn:aws:s3:::YOUR-RANDS-BUCKET/representations/exe/*",
        "arn:aws:s3:::YOUR-RANDS-BUCKET/metadata/Benign.csv",
        "arn:aws:s3:::YOUR-RANDS-BUCKET/metadata/Ransomware.csv"
      ]
    },
    {
      "Sid": "TrainingArtifactsAndPermissionProbe",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": "arn:aws:s3:::YOUR-RANDS-BUCKET/experiments/*"
    }
  ]
}
